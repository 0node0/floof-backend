DATABASE_URL=postgres://postgres:postgres@localhost:5432/floof_medusa
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace_with_openssl_rand_hex_32
COOKIE_SECRET=replace_with_openssl_rand_hex_32_different_from_jwt
STORE_CORS=http://localhost:4321,https://floof.space,https://www.floof.space
ADMIN_CORS=http://localhost:9000,https://floof.space,https://www.floof.space
AUTH_CORS=http://localhost:9000,https://floof.space,https://www.floof.space
MEDUSA_BACKEND_URL=http://localhost:9000
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Private API token from https://www.printful.com/dashboard/settings/api
PRINTFUL_API_TOKEN=replace_with_printful_private_token
# Optional — required only for OAuth / multi-store tokens
PRINTFUL_STORE_ID=
# Random hex used as /webhooks/printful/:secret path segment (openssl rand -hex 32)
PRINTFUL_WEBHOOK_PATH=replace_with_openssl_rand_hex_32
# Shared secret for Studio + design product API (x-floof-admin-key)
FLOOF_ADMIN_KEY=replace_with_openssl_rand_hex_32
# Public backend URL (required so Printful can fetch staged design uploads)
# MEDUSA_BACKEND_URL=https://floof-backend-production-6742.up.railway.app
# Checkout shipping (Stripe Checkout line — subtotal excludes shipping/tax until session)
SHIPPING_FREE_THRESHOLD_USD=75
SHIPPING_FLAT_RATE_USD=6.99
# SHIPPING_FREE_THRESHOLD_CENTS=7500
# SHIPPING_FLAT_RATE_CENTS=699
SHIPPING_USE_PRINTFUL_RATES=true
# Stripe Tax in Checkout (enable in Stripe Dashboard first)
STRIPE_AUTOMATIC_TAX=false
# Printful order.placed: confirm immediately (false = leave draft for manual review)
PRINTFUL_AUTO_CONFIRM=true
NODE_ENV=development
PORT=9000
